# 실행 시 자동 생성 — 커밋하면 오래된 DB를 쓰게 된다
*.db

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 로그
*.log

# Excel 임시 잠금 파일
~$*.xlsx

# 비밀값 — 절대 커밋 금지
