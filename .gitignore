# 실행 시 자동 생성 — 커밋하면 오래된 DB를 쓰게 된다
*.db

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 로그
*.log

# Excel 임시 잠금 파일
~$*.xlsx

# Streamlit 비밀값 (API 키 등) — 절대 커밋 금지
.streamlit/secrets.toml

# 비밀값 사본 — 메모장이 .txt를 붙인 형태까지 모두 차단
.secrets.toml*
**/.secrets.toml*
secrets.toml
**/secrets.toml

# 실행 로그·평가 산출물
